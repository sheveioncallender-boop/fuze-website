<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fuze_restaurant" model="ir.module.category">
        <field name="name">Fuze Restaurant</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_fuze_kitchen" model="res.groups.privilege">
        <field name="name">Kitchen Display</field>
        <field name="category_id" ref="fuze_website.module_category_fuze_restaurant"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_fuze_kitchen_user" model="res.groups">
        <field name="name">Kitchen Display User</field>
        <field name="privilege_id" ref="fuze_website.privilege_fuze_kitchen"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_fuze_kitchen_manager" model="res.groups">
        <field name="name">Kitchen Display Manager</field>
        <field name="privilege_id" ref="fuze_website.privilege_fuze_kitchen"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('fuze_website.group_fuze_kitchen_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>

    <record id="rule_fuze_station_company" model="ir.rule">
        <field name="name">Fuze stations: multi-company</field>
        <field name="model_id" ref="model_fuze_kitchen_station"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_fuze_display_company" model="ir.rule">
        <field name="name">Fuze displays: multi-company</field>
        <field name="model_id" ref="model_fuze_kitchen_display"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
