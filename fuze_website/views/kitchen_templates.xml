<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <template id="fuze_kitchen_display" name="Fuze Kitchen Display">
    <html lang="en">
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
        <meta name="theme-color" content="#2d0055"/>
        <title>Kitchen Display | Fuze Restaurant</title>
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&amp;family=DM+Sans:wght@400;500;600;700&amp;display=swap"/>
        <link rel="stylesheet" href="/fuze_website/static/src/css/kitchen-display.css?v=19.0.2.0.5"/>
      </head>
      <body><div class="kds-app" id="kdsApp">
    <header class="kds-header">
      <div class="kds-header__brand">
        <img src="/fuze_website/static/src/images/fuze-logo-transparent.png" alt="Fuze Restaurant"/>
        <div><span>Restaurant operations</span><strong>Kitchen Display</strong></div>
      </div>

      <div class="kds-header__shift">
        <span class="kds-live-dot" aria-hidden="true"/>
        <div><small>Live service</small><strong id="liveClock">--:-- --</strong></div>
      </div>

      <div class="kds-header__actions">
        <button class="kds-icon-button" id="soundButton" type="button" aria-label="Mute new order sound" title="Sound on">
          <svg aria-hidden="true" viewbox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4Zm12.5 3a4.5 4.5 0 0 0-2.1-3.8v7.6a4.5 4.5 0 0 0 2.1-3.8Zm-2.1-8.7v2.2a7.2 7.2 0 0 1 0 13v2.2a9.3 9.3 0 0 0 0-17.4Z"/></svg>
          <span>Sound</span>
        </button>
        <button class="kds-icon-button" id="fullscreenButton" type="button" aria-label="Enter fullscreen" title="Fullscreen">
          <svg aria-hidden="true" viewbox="0 0 24 24"><path d="M4 9V4h5v2H6v3H4Zm11-5h5v5h-2V6h-3V4Zm3 11h2v5h-5v-2h3v-3ZM9 18v2H4v-5h2v3h3Z"/></svg>
          <span>Full screen</span>
        </button>
        <button class="kds-icon-button" id="settingsButton" type="button" aria-expanded="false" aria-controls="settingsDrawer">
          <svg aria-hidden="true" viewbox="0 0 24 24"><path d="M19.4 13a7.7 7.7 0 0 0 .1-1 7.7 7.7 0 0 0-.1-1l2.1-1.7-2-3.5-2.6 1a7.9 7.9 0 0 0-1.7-1L14.8 3h-4l-.4 2.8a7.9 7.9 0 0 0-1.7 1l-2.6-1-2 3.5L6.2 11a7.7 7.7 0 0 0-.1 1 7.7 7.7 0 0 0 .1 1l-2.1 1.7 2 3.5 2.6-1a7.9 7.9 0 0 0 1.7 1l.4 2.8h4l.4-2.8a7.9 7.9 0 0 0 1.7-1l2.6 1 2-3.5L19.4 13ZM12.8 15.7a3.8 3.8 0 1 1 0-7.5 3.8 3.8 0 0 1 0 7.5Z"/></svg>
          <span>Options</span>
        </button>
      </div>
    </header>

    <section class="kds-control-bar" aria-label="Kitchen display controls">
      <div class="kds-control-group kds-control-group--branch">
        <span>Viewing branch</span>
        <div class="kds-segmented" id="branchFilters" role="group" aria-label="Select branch">
          <button class="is-active" type="button" data-branch="east">East Gates</button>
          <button type="button" data-branch="bagshot">Bagshot</button>
          <button type="button" data-branch="all">Both</button>
        </div>
      </div>
      <div class="kds-control-group kds-control-group--station">
        <span>Preparation station</span>
        <div class="kds-stations" id="stationFilters" role="group" aria-label="Select preparation station">
          <button class="is-active" type="button" data-station="all">All <b id="stationAllCount">0</b></button>
          <button type="button" data-station="grill">Grill</button>
          <button type="button" data-station="fryer">Fryer</button>
          <button type="button" data-station="kitchen">Kitchen</button>
          <button type="button" data-station="drinks">Drinks</button>
          <button type="button" data-station="dessert">Dessert</button>
        </div>
      </div>
      <button class="kds-demo-button" id="newDemoOrder" type="button"><span>＋</span> Simulate new order</button>
    </section>

    <nav class="kds-stage-tabs" id="stageTabs" aria-label="Order stages">
      <button class="is-active" type="button" data-stage="new"><span>New</span><b>0</b></button>
      <button type="button" data-stage="acknowledged"><span>Acknowledged</span><b>0</b></button>
      <button type="button" data-stage="preparing"><span>Preparing</span><b>0</b></button>
      <button type="button" data-stage="ready"><span>Ready</span><b>0</b></button>
      <button type="button" data-stage="completed"><span>Completed</span><b>0</b></button>
      <button type="button" data-stage="cancelled"><span>Cancelled</span><b>0</b></button>
    </nav>

    <main class="kds-workspace">
      <section class="kds-workspace__heading">
        <div>
          <p><span class="kds-live-dot" aria-hidden="true"/><strong id="workspaceBranch">East Gates</strong> · <span id="workspaceStation">All stations</span></p>
          <h1 id="workspaceTitle">NEW ORDERS</h1>
        </div>
        <div class="kds-workspace__summary"><span id="visibleOrderCount">0</span><small>orders<br/>on screen</small></div>
      </section>

      <section class="kds-order-grid" id="orderGrid" aria-live="polite"/>

      <section class="kds-empty" id="emptyState" hidden="">
        <div>✓</div>
        <p>All clear</p>
        <h2>NO ORDERS<br/>IN THIS STAGE.</h2>
        <span>New tickets will appear here automatically.</span>
      </section>
    </main>

    <footer class="kds-footer">
      <div><span class="kds-live-dot"/><strong>Connected to Odoo POS</strong><small>Design preview · simulated data</small></div>
      <p><kbd>1–6</kbd> stages <kbd>A</kbd> acknowledge <kbd>S</kbd> start <kbd>R</kbd> ready <kbd>M</kbd> mute</p>
      <span>Fuze Operations</span>
    </footer>
  </div>

  <div class="kds-drawer-backdrop" id="drawerBackdrop" hidden=""/>
  <aside class="kds-settings" id="settingsDrawer" aria-hidden="true" aria-label="Kitchen display options">
    <header><div><p>Display controls</p><h2>FUZE OPTIONS</h2></div><button id="closeSettings" type="button" aria-label="Close settings">×</button></header>
    <div class="kds-settings__body">
      <section>
        <h3>New-order sound</h3>
        <label class="kds-switch-row"><span><strong>Sound alerts</strong><small>Play a tone when an order arrives.</small></span><input id="soundToggle" type="checkbox" checked="checked"/><i/></label>
        <label class="kds-switch-row"><span><strong>Repeat until acknowledged</strong><small>Repeat every 20 seconds.</small></span><input id="repeatToggle" type="checkbox" checked="checked"/><i/></label>
        <label class="kds-range-row"><span><strong>Alert volume</strong><output id="volumeValue">70%</output></span><input id="volumeControl" type="range" min="0" max="100" value="70"/></label>
        <button class="kds-settings-button" id="testSound" type="button">Test new-order sound <span>♪</span></button>
      </section>
      <section>
        <h3>Ticket appearance</h3>
        <label class="kds-switch-row"><span><strong>Product images</strong><small>Show menu photos on order lines.</small></span><input id="imageToggle" type="checkbox" checked="checked"/><i/></label>
        <div class="kds-choice-row"><span><strong>Card density</strong><small>Choose spacing for this screen.</small></span><div><button class="is-active" type="button" data-density="comfortable">Comfort</button><button type="button" data-density="compact">Compact</button></div></div>
      </section>
      <section>
        <h3>Service tools</h3>
        <button class="kds-settings-button" id="resetDemo" type="button">Reset demonstration orders <span>↻</span></button>
        <p class="kds-settings-note">In Odoo, branches, stations, sounds and ticket stages will be saved per preparation display.</p>
      </section>
    </div>
  </aside>

  <dialog class="kds-start" id="startDialog">
    <div class="kds-start__mark"><img src="/fuze_website/static/src/images/fuze-logo-transparent.png" alt="Fuze Restaurant"/></div>
    <p>Restaurant operations</p>
    <h2>START THE<br/><span>KITCHEN DISPLAY.</span></h2>
    <p class="kds-start__copy">One tap enables new-order sound and starts the live kitchen clock. Your selected Fuze branch will remain saved on this screen.</p>
    <div class="kds-start__branch">
      <span>Start at</span>
      <label><input type="radio" name="startBranch" value="east" checked="checked"/><i>East Gates Mall</i></label>
      <label><input type="radio" name="startBranch" value="bagshot"/><i>Bagshot BoxPark</i></label>
    </div>
    <button id="startDisplay" type="button">Start display <span>→</span></button>
    <small>Sound can be changed at any time in Options.</small>
  </dialog>

  <dialog class="kds-cancel" id="cancelDialog">
    <form method="dialog">
      <header><div><p>Kitchen control</p><h2>CANCEL ITEM</h2></div><button value="close" aria-label="Close">×</button></header>
      <p>Choose a reason. The cancelled item and reason will remain visible on the ticket and in Odoo’s audit record.</p>
      <input type="hidden" id="cancelOrderId"/>
      <input type="hidden" id="cancelItemId"/>
      <div class="kds-cancel__reasons">
        <label><input type="radio" name="cancelReason" value="Out of stock"/><span>Out of stock</span></label>
        <label><input type="radio" name="cancelReason" value="Customer requested"/><span>Customer requested</span></label>
        <label><input type="radio" name="cancelReason" value="Duplicate item"/><span>Duplicate item</span></label>
        <label><input type="radio" name="cancelReason" value="Kitchen error"/><span>Kitchen error</span></label>
      </div>
      <label class="kds-cancel__note"><span>Additional note <small>Optional</small></span><textarea id="cancelNote" placeholder="Add more context"/></label>
      <button class="kds-cancel__confirm" id="confirmCancel" type="button">Confirm cancellation</button>
    </form>
  </dialog>

  <div class="kds-toast" id="kdsToast" role="status" aria-live="polite"/>
  <script>window.FUZE_KDS_BOOTSTRAP = <t t-out="fuze_kds_bootstrap"/>;</script><script src="/fuze_website/static/src/js/kitchen-display.js?v=19.0.2.0.5"> </script></body>
    </html>
  </template>
</odoo>
