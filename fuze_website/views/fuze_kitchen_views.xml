<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fuze_kitchen_station_list" model="ir.ui.view">
        <field name="name">fuze.kitchen.station.list</field>
        <field name="model">fuze.kitchen.station</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" placeholder="#2d0055"/>
                <field name="pos_config_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fuze_kitchen_station_form" model="ir.ui.view">
        <field name="name">fuze.kitchen.station.form</field>
        <field name="model">fuze.kitchen.station</field>
        <field name="arch" type="xml">
            <form string="Preparation Station">
                <sheet>
                    <group>
                        <group><field name="name"/><field name="code"/><field name="sequence"/></group>
                        <group><field name="color" placeholder="#2d0055"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group>
                    </group>
                    <notebook>
                        <page string="Locations"><field name="pos_config_ids" widget="many2many_tags"/></page>
                        <page string="Default Categories"><field name="pos_category_ids" widget="many2many_tags"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fuze_kitchen_display_list" model="ir.ui.view">
        <field name="name">fuze.kitchen.display.list</field>
        <field name="model">fuze.kitchen.display</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pos_config_ids" widget="many2many_tags"/>
                <field name="station_ids" widget="many2many_tags"/>
                <field name="sound_enabled"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fuze_kitchen_display_form" model="ir.ui.view">
        <field name="name">fuze.kitchen.display.form</field>
        <field name="model">fuze.kitchen.display</field>
        <field name="arch" type="xml">
            <form string="Kitchen Display">
                <header><button name="action_open_display" type="object" string="Open Kitchen Display" class="btn-primary"/></header>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group>
                        <group><field name="pos_config_ids" widget="many2many_tags"/><field name="station_ids" widget="many2many_tags"/></group>
                    </group>
                    <notebook>
                        <page string="Sound">
                            <group><field name="sound_enabled"/><field name="repeat_sound"/><field name="repeat_seconds"/><field name="volume" widget="progressbar"/></group>
                        </page>
                        <page string="Appearance">
                            <group><field name="show_images"/><field name="density"/><field name="urgent_after"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fuze_kitchen_stations" model="ir.actions.act_window">
        <field name="name">Preparation Stations</field><field name="res_model">fuze.kitchen.station</field><field name="view_mode">list,form</field>
    </record>
    <record id="action_fuze_kitchen_displays" model="ir.actions.act_window">
        <field name="name">Kitchen Displays</field><field name="res_model">fuze.kitchen.display</field><field name="view_mode">list,form</field>
    </record>
    <record id="action_fuze_kitchen_orders" model="ir.actions.act_window">
        <field name="name">Kitchen Orders</field><field name="res_model">pos.order</field><field name="view_mode">list,form</field>
        <field name="domain">[('fuze_kds_order', '=', True)]</field>
        <field name="context">{'search_default_fuze_active': 1}</field>
    </record>
    <record id="action_fuze_kitchen_display_url" model="ir.actions.act_url">
        <field name="name">Open Kitchen Display</field><field name="url">/fuze/kitchen</field><field name="target">self</field>
    </record>

    <menuitem id="menu_fuze_root" name="Fuze Restaurant" sequence="25" groups="fuze_website.group_fuze_kitchen_user,base.group_system"/>
    <menuitem id="menu_fuze_kitchen_open" name="Kitchen Display" parent="menu_fuze_root" action="action_fuze_kitchen_display_url" sequence="10"/>
    <menuitem id="menu_fuze_kitchen_orders" name="Kitchen Orders" parent="menu_fuze_root" action="action_fuze_kitchen_orders" sequence="20"/>
    <menuitem id="menu_fuze_config_root" name="Configuration" parent="menu_fuze_root" sequence="90" groups="fuze_website.group_fuze_kitchen_manager,base.group_system"/>
    <menuitem id="menu_fuze_displays" name="Displays" parent="menu_fuze_config_root" action="action_fuze_kitchen_displays" sequence="10"/>
    <menuitem id="menu_fuze_stations" name="Preparation Stations" parent="menu_fuze_config_root" action="action_fuze_kitchen_stations" sequence="20"/>
    <menuitem id="menu_fuze_pos_configs" name="POS Locations" parent="menu_fuze_config_root" action="point_of_sale.action_pos_config_tree" sequence="30"/>
    <menuitem id="menu_fuze_products" name="Menu Products" parent="menu_fuze_config_root" action="point_of_sale.product_template_action_pos_product" sequence="40"/>
</odoo>
