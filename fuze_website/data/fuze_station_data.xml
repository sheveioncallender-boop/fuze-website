<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="station_grill" model="fuze.kitchen.station">
        <field name="name">Grill</field><field name="code">grill</field><field name="sequence">10</field><field name="color">#ff4b12</field>
    </record>
    <record id="station_fryer" model="fuze.kitchen.station">
        <field name="name">Fryer</field><field name="code">fryer</field><field name="sequence">20</field><field name="color">#ff7a00</field>
    </record>
    <record id="station_kitchen" model="fuze.kitchen.station">
        <field name="name">Kitchen</field><field name="code">kitchen</field><field name="sequence">30</field><field name="color">#2d0055</field>
    </record>
    <record id="station_drinks" model="fuze.kitchen.station">
        <field name="name">Drinks</field><field name="code">drinks</field><field name="sequence">40</field><field name="color">#1c8ca1</field>
    </record>
    <record id="station_dessert" model="fuze.kitchen.station">
        <field name="name">Dessert</field><field name="code">dessert</field><field name="sequence">50</field><field name="color">#bd3184</field>
    </record>

    <record id="display_main" model="fuze.kitchen.display">
        <field name="name">Fuze Main Kitchen Display</field>
        <field name="station_ids" eval="[(6, 0, [ref('station_grill'), ref('station_fryer'), ref('station_kitchen'), ref('station_drinks'), ref('station_dessert')])]"/>
    </record>
</odoo>
